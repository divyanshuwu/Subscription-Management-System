# Copy to .env. All runtime services are local.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
# Omit DATABASE_URL to use SQLite. For docker compose Postgres:
# DATABASE_URL=postgresql://brightloop:brightloop_local@127.0.0.1:5432/brightloop
SQLITE_PATH=backend/data/brightloop.sqlite
REMINDER_DAYS=7
SCHEDULER=on
