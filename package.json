    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "framer-motion": "^12.35.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
